{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "policy",
            "human_approval"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "actor",
        "evidence_reference"
      ],
      "additionalProperties": false
    },
    "exception": {
      "type": "boolean"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "executed",
        "failed",
        "unknown"
      ]
    },
    "observed_result_reference": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "workflow_id",
    "recorded_at",
    "decision",
    "evidence_refs",
    "policy_version",
    "policy_sha256",
    "scope",
    "authority",
    "exception",
    "expires_at",
    "outcome",
    "observed_result_reference",
    "supersedes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "exception": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "executed",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "observed_result_reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision"
}
