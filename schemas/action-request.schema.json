{
  "type": "object",
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "mutates": {
      "type": "boolean"
    },
    "calls_used": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "projected_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "request_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "evidence_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "by",
            "request_sha256",
            "expires_at",
            "evidence_path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "execution_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "workflow_id",
    "action",
    "paths",
    "hosts",
    "mutates",
    "calls_used",
    "elapsed_seconds",
    "cost_usd",
    "projected_cost_usd",
    "approval"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "action-request"
}
