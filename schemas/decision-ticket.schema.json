{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "question": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1200,
      "pattern": "\\S"
    },
    "resolver": {
      "enum": [
        "source_lookup",
        "research",
        "interview",
        "prototype",
        "prerequisite"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "priority_reason": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600,
      "pattern": "\\S"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "allowed_outcomes": {
            "type": "array",
            "items": {
              "enum": [
                "accepted",
                "rejected"
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          }
        },
        "required": [
          "ticket_id",
          "allowed_outcomes"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "delegated",
            "human_required"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      },
      "required": [
        "mode",
        "owner",
        "policy_ref"
      ],
      "additionalProperties": false
    },
    "workflow_contract": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "max_minutes",
        "max_cost_usd"
      ],
      "additionalProperties": false
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 600
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "question",
    "resolver",
    "priority",
    "priority_reason",
    "depends_on",
    "required_evidence",
    "authority",
    "workflow_contract",
    "budgets",
    "evidence_requirements"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision-ticket"
}
