{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "package": {
                "type": "string",
                "pattern": "^[A-Za-z0-9@][A-Za-z0-9@._/:-]{0,199}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
              },
              "repository": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "subdirectory": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "purpose": {
                "type": "string",
                "minLength": 10,
                "maxLength": 2000
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "license_path": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "package",
              "version",
              "repository",
              "subdirectory",
              "purpose",
              "owner",
              "license_path"
            ],
            "additionalProperties": false
          },
          "identity": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "content-snapshot",
                  "git-commit"
                ]
              },
              "provider": {
                "enum": [
                  "local-import",
                  "opensrc",
                  "git-local",
                  "git-https"
                ]
              },
              "provider_version": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "commit": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{40}$"
              },
              "origin": {
                "enum": [
                  "unverified",
                  "local-object",
                  "remote-fetch"
                ]
              }
            },
            "required": [
              "kind",
              "provider",
              "provider_version",
              "commit",
              "origin"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "git-commit"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "commit": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    },
                    "origin": {
                      "enum": [
                        "local-object",
                        "remote-fetch"
                      ]
                    },
                    "provider": {
                      "enum": [
                        "git-local",
                        "git-https"
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "commit": {
                      "type": "null"
                    },
                    "origin": {
                      "const": "unverified"
                    },
                    "provider": {
                      "enum": [
                        "opensrc",
                        "local-import"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "snapshot": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "file_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 67108864
              }
            },
            "required": [
              "sha256",
              "file_count",
              "bytes"
            ],
            "additionalProperties": false
          },
          "license": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            ]
          },
          "mapping": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "UNVERIFIED",
                  "REVIEWED"
                ]
              },
              "review": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "by": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "evidence_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "recorded_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "by",
                      "evidence",
                      "evidence_sha256",
                      "recorded_at"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "status",
              "review"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "REVIEWED"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "review": {
                      "type": "object",
                      "properties": {
                        "by": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "evidence": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "evidence_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "recorded_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "by",
                        "evidence",
                        "evidence_sha256",
                        "recorded_at"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "else": {
                  "properties": {
                    "review": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "warning": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "request",
          "identity",
          "snapshot",
          "license",
          "mapping",
          "warning",
          "created_at"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mapping": {
                  "properties": {
                    "status": {
                      "const": "REVIEWED"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "identity": {
                  "properties": {
                    "kind": {
                      "const": "git-commit"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false
}
