{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "command",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "timeout_seconds"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "method",
          "tests",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[a-z][a-z0-9-]*-[0-9]{3,}$"
          },
          "method": {
            "enum": [
              "automated",
              "manual",
              "post_release"
            ]
          },
          "tests": {
            "type": "array",
            "maxItems": 200,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "reason": {
            "type": "string",
            "minLength": 15,
            "maxLength": 1000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "method": {
                  "const": "automated"
                }
              }
            },
            "then": {
              "properties": {
                "tests": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "tests": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
