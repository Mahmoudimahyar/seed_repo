{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "active",
              "deferred"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 15
          },
          "doc_root": {
            "type": "string",
            "minLength": 1
          },
          "ui": {
            "type": "boolean"
          },
          "code": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "owner",
          "status",
          "reason",
          "doc_root",
          "ui",
          "code",
          "tests"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "features"
  ],
  "additionalProperties": false
}
