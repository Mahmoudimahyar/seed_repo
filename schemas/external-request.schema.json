{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "package": {
      "type": "string",
      "pattern": "^[A-Za-z0-9@][A-Za-z0-9@._/:-]{0,199}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "subdirectory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "license_path": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    }
  },
  "required": [
    "id",
    "package",
    "version",
    "repository",
    "subdirectory",
    "purpose",
    "owner",
    "license_path"
  ],
  "additionalProperties": false
}
